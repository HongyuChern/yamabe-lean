import Yamabe3.Analysis.UniformElliptic.NativeDelaunayOperatorError
import Yamabe3.Analysis.UniformElliptic.NativeDivergenceSource

/-!
# The scaled differential expression is the actual native Jacobian

This records the same physical radial background, with the phase change
sigma-log(r), and the same scaled correction w(r z). The coefficient is
exactly r^2 rho/8 times -8 Delta + R - 30 U^4. The earlier small operator
error therefore compares actual native and flat Delaunay Jacobians.
-/

noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1500000

open Set Filter
open scoped ContDiff Topology

namespace Yamabe3.Analysis.UniformElliptic

open PoincareMT Delaunay
open Poincare.Analysis.Elliptic.InteriorEstimates

local notation "E3" => EuclideanSpace ℝ (Fin 3)

theorem radialScale_mul_positive {r s : ℝ} (hr : 0 < r) (hs : 0 < s) :
    radialScale (r * s) = radialScale r * radialScale s := by
  unfold radialScale
  rw [Real.log_mul hr.ne' hs.ne', ← Real.exp_add]
  congr 1
  ring

/-- The rescaled background is the same physical radial function with
exactly the logarithmic phase shift generated by dilation. -/
theorem delaunayRescaledBackground_eq_physical_radialProfile
    (v : ℝ → ℝ) (σ : ℝ) {r : ℝ} (hr : 0 < r) {z : E3} (hz : z ≠ 0) :
    delaunayRescaledBackground v r (σ - Real.log r) z =
      radialProfile v σ ‖r • z‖ := by
  have hn : 0 < ‖z‖ := norm_pos_iff.mpr hz
  rw [radialProfile, norm_smul, Real.norm_of_nonneg hr.le,
    radialScale_mul_positive hr hn, Real.log_mul hr.ne' hn.ne']
  unfold delaunayRescaledBackground
  congr 2
  ring

/-- Exact density/radius/coefficient-eight identity for the actual native
Jacobian of the same physical background and correction. -/
theorem nativeRescaledDelaunayJacobian_eq_actual_native_jacobian
    (g : RiemannianMetric 3 E3) (v : ℝ → ℝ) (σ : ℝ)
    {r : ℝ} (hr : 0 < r) {w : E3 → ℝ} {z : E3}
    (hw : ContDiffAt ℝ ∞ w (r • z)) (hz : z ≠ 0) :
    nativeRescaledDelaunayJacobian g r v (σ - Real.log r) (fun y => w (r • y)) z =
      (r ^ 2 * g.pullbackVolumeDensity id (r • z) / 8) *
        (-8 * g.leviCivitaData.laplacian w (r • z) +
          (g.leviCivitaData.scalarCurvature (r • z) -
            30 * radialProfile v σ ‖r • z‖ ^ 4) * w (r • z)) := by
  have hscale : principalSource (fun y => nativeDivergenceMatrix g (r • y))
      (fun y => w (r • y)) z = r ^ 2 * principalSource (nativeDivergenceMatrix g) w (r • z) := by
    simpa only [sub_zero, one_mul] using
      principalSource_scaled_centered (nativeDivergenceMatrix g) w r 1 0 z
  rw [nativeRescaledDelaunayJacobian, hscale,
    native_principalSource_eq_negative_density_laplacian g g.leviCivitaData hw,
    rescaledNativeJacobianPotential,
    delaunayRescaledBackground_eq_physical_radialProfile v σ hr hz]
  ring

/-- Thus a true native solution supplies this same scaled flat equation
with the literal geometric error, rather than an independent source. -/
theorem actual_native_delaunay_jacobian_eq_flat_plus_error
    (g : RiemannianMetric 3 E3) (v : ℝ → ℝ) (σ : ℝ)
    {r : ℝ} (hr : 0 < r) {O : Set E3} (hO : IsOpen O)
    {w : E3 → ℝ} (hw : ContDiffOn ℝ ∞ w O) {z : E3}
    (hzO : r • z ∈ O) (hz : z ≠ 0) :
    (r ^ 2 * g.pullbackVolumeDensity id (r • z) / 8) *
        (-8 * g.leviCivitaData.laplacian w (r • z) +
          (g.leviCivitaData.scalarCurvature (r • z) -
            30 * radialProfile v σ ‖r • z‖ ^ 4) * w (r • z)) =
      flatDelaunayJacobian v (σ - Real.log r) (fun y => w (r • y)) z +
        nativeDelaunayOperatorError g r v (σ - Real.log r) (fun y => w (r • y)) z := by
  have hpre : IsOpen ((fun y : E3 => r • y) ⁻¹' O) :=
    hO.preimage (continuous_id.const_smul r)
  have hws : ContDiffOn ℝ ∞ (fun y : E3 => w (r • y)) ((fun y : E3 => r • y) ⁻¹' O) :=
    hw.comp (contDiff_id.const_smul r).contDiffOn (fun _ h => h)
  have hid := nativeDelaunayOperatorError_eq_operator_difference g hr v (σ - Real.log r)
    hpre hws hzO hz
  rw [nativeRescaledDelaunayJacobian_eq_actual_native_jacobian g v σ hr
    (hw.contDiffAt (hO.mem_nhds hzO)) hz] at hid
  linarith

#print axioms delaunayRescaledBackground_eq_physical_radialProfile
#print axioms nativeRescaledDelaunayJacobian_eq_actual_native_jacobian
#print axioms actual_native_delaunay_jacobian_eq_flat_plus_error

end Yamabe3.Analysis.UniformElliptic
